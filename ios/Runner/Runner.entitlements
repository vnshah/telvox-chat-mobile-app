<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications through APNs (Firebase delivers to iPhones through it).
	     Xcode switches this to production for App Store and TestFlight builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Shared with the Share Extension, so "share to Telvox Chat" reaches the app. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.telvox.telvoxChatMobileApp</string>
	</array>
</dict>
</plist>
